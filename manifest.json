{
	"name": "Trg",
	"description": "",
	"version": "0.0.1",
	"manifest_version": 3,
	"action": {
		"default_popup": "index.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    },
		"default_title": "Trg"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["src/content.ts"],
      "run_at": "document_start"
		}
	],
	"background": {
		"service_worker": "src/background.ts",
		"type": "module"
	},
	"permissions": [
    "contextMenus",
		"background",
		"tabs",
		"storage"
	],
  "host_permissions": ["<all_urls>"],

  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}