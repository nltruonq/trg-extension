{
  "manifest_version": 3,
  "name": "Trg",
  "description": "Ch\u1eb7n v\u00e0 l\u00e0m m\u1edd n\u1ed9i dung tr\u00ean trang web theo t\u1eebng domain.",
  "version": "0.0.1",
  "action": {
    "default_popup": "index.html",
    "default_title": "Trg",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "tabs",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
