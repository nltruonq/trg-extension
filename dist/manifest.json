{
  "manifest_version": 3,
  "name": "Trg",
  "description": "Chặn và làm mờ nội dung trên trang web theo từng domain.",
  "version": "0.0.1",
  "action": {
    "default_popup": "index.html",
    "default_title": "Trg",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-PiAViAPY.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/storage-cq07BUTL.js",
        "assets/constants-ZjAMyEnb.js",
        "assets/index.ts-CcAaWbOP.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
